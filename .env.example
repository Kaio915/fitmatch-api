# ============================================================
# FitMatch - Variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# Obs.: o Spring Boot lê variáveis de AMBIENTE do sistema/Docker/Dokploy,
# não este arquivo diretamente. Ele serve de referência e para
# "docker run --env-file .env" se necessário.
# ============================================================

# ---- Perfil / Servidor ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- Banco de dados (PostgreSQL) ----
DB_URL=jdbc:postgresql://localhost:5432/fitmatch
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SHOW_SQL=true

# ---- JWT ----
# JWT_SECRET deve ter pelo menos 32 caracteres (use um valor forte em produção).
JWT_SECRET=dev-dev-dev-dev-dev-dev-dev-dev-dev-dev-123456
JWT_EXPIRATION_MS=14400000

# ---- E-mail (SMTP via Gmail) ----
# Passo a passo:
#   1) Ative a verificação em 2 etapas:  https://myaccount.google.com/security
#   2) Crie uma "senha de app":          https://myaccount.google.com/apppasswords
#      (App: "Mail" | Dispositivo: "Outro (nome personalizado)" -> "FitMatch")
#   3) Cole a senha de app de 16 caracteres em MAIL_PASSWORD (ignore os espaços).
#
# ATENÇÃO: MAIL_FROM deve ser o MESMO e-mail da conta autenticada.
# O Gmail reescreve o remetente, então não use no-reply@fitmatch.page aqui.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua_senha_de_app
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=seuemail@gmail.com
MAIL_ENABLED=true

# ---- Edamam (banco de alimentos) ----
EDAMAM_ENABLED=true
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
EDAMAM_BASE_URL=https://api.edamam.com
EDAMAM_ACCOUNT_USER=

# ---- CREF ----
CREF_AUTO_LOOKUP_ENABLED=false
CREF_AUTO_LOOKUP_URL_TEMPLATE=
CREF_MANUAL_URL_TEMPLATE=https://www.confef.org.br/confef/registrados/
CREF_AUTO_LOOKUP_TIMEOUT_SECONDS=8
